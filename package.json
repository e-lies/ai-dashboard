{
  "name": "tq-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reporting et dashboards à partir de fichiers Excel/CSV, avec profilage et chatbot IA.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "apache-arrow": "^17.0.0",
    "dotenv": "^18.0.10",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "fastify": "^5.12.8",
    "idb-keyval": "^6.3.0",
    "nanoid": "^6.0.2",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
