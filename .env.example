# Fournisseur LLM utilisé par le proxy (seul « anthropic » est implémenté pour l'instant)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Port du proxy API (Vite redirige /api vers ce port)
API_PORT=8787

# Port de l'interface web. Il doit rester fixe : les données (IndexedDB) sont liées
# à l'adresse http://localhost:<port>. Changer de port donne une base vide.
WEB_PORT=5176
