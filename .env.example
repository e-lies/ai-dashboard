# IA infonuagique : génération du SQL du chatbot, à partir du schéma seulement
# (noms, types, rôles et descriptions des colonnes ; jamais de valeurs des données).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# IA locale (Ollama), facultative : analyse des colonnes à l'import et rédaction des réponses du
# chatbot à partir des résultats. Ces deux usages voient des valeurs des données et ne passent
# jamais par l'IA infonuagique. Sans ces variables, l'import reste heuristique et le chat affiche
# le résultat sans le commenter.
# Sur le Mac, Ollama doit écouter sur le réseau : OLLAMA_HOST=0.0.0.0 (par défaut, localhost seulement).
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
# Délai maximal d'une réponse (ms) et taille du contexte (jetons) pour l'IA locale.
LOCAL_LLM_TIMEOUT_MS=180000
LOCAL_LLM_NUM_CTX=8192

# Port du proxy API (Vite redirige /api vers ce port)
API_PORT=8787

# Port de l'interface web. Il doit rester fixe : les données (IndexedDB) sont liées
# à l'adresse http://localhost:<port>. Changer de port donne une base vide.
WEB_PORT=5176
